# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# --- Optional ---

# Path to your Traktor collection.nml. CrateHacker auto-detects it, but if
# auto-detection fails or you keep your collection in a custom location, set
# the absolute path here. The app rewrites this value on each successful run.
# COLLECTION_FILE=C:\Users\you\Documents\Native Instruments\Traktor Pro 4\collection.nml

# Search directories for hard drive scan (pipe-separated). Managed by the UI;
# rarely edited by hand.
# SEARCH_DIRS=D:\Music|C:\Users\you\Music

# Set to 1/true to force the app to use the bundled testfiles/collection.nml
# instead of auto-detecting the real Traktor library. Useful for local dev only.
# CRATEHACKER_DEV_TEST=1
